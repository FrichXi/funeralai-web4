{
  "name": "site",
  "version": "0.1.0",
  "packageManager": "npm@10.9.4",
  "private": true,
  "scripts": {
    "prebuild": "bash prebuild.sh",
    "stage:test": "STAGE_TEST=required node scripts/stage-test-sites.mjs",
    "render:leaderboard-image": "node scripts/render-leaderboard-image.mjs",
    "dev": "bash prebuild.sh && next dev",
    "build": "next build && npm run render:leaderboard-image && python3 ../scripts/release_guard.py finalize --mode ${STAGE_TEST:-skip}",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "check": "npm run lint && npm run test",
    "release:verify": "python3 ../scripts/release_guard.py verify-local --mode required",
    "predeploy": "cd .. && scripts/doctor_repo.sh --profile release",
    "deploy": "cd .. && scripts/deploy_site.sh --profile release",
    "deploy:content": "cd .. && scripts/deploy_site.sh --profile content",
    "deploy:test-benchmark": "cd .. && scripts/deploy_site.sh --profile test-benchmark",
    "deploy:site-ui": "cd .. && scripts/deploy_site.sh --profile site-ui",
    "deploy:raw": "node -e \"if(process.env.ALLOW_RAW_PAGES_DEPLOY!=='1')throw new Error('Set ALLOW_RAW_PAGES_DEPLOY=1 for non-production diagnostics only')\" && wrangler pages deploy out --project-name funeral-ai-web4 --branch diagnostics-only"
  },
  "engines": {
    "node": ">=20 <26"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cytoscape": "^3.33.1",
    "cytoscape-fcose": "^2.2.0",
    "lucide-react": "^0.577.0",
    "next": "15.5.21",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.5.21",
    "playwright-core": "^1.57.0",
    "postcss": "8.5.24",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "postcss": "8.5.24"
  }
}
